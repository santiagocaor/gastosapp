{
  "name": "GastosApp - Control de Gastos y Presupuestos",
  "short_name": "GastosApp",
  "description": "Control de gastos, ingresos y presupuestos personales sincronizado con Google Sheets",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8f9ff",
  "theme_color": "#004f35",
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
